          </CardSection>

          <CardSection title={t('eg.insurance')} gradient="from-rose-400 to-fuchsia-500" delay="200ms">
            <fieldset style={{ border: 0, padding: 0, margin: '0 0 0.875rem' }}>
              <legend style={labelStyle}>
                {t('eg.insuranceLegend')} <span style={hintStyle}>{t('eg.insuranceLegendHint')}</span>
              </legend>
              <div className="flex flex-wrap gap-x-4 gap-y-2">
                <ModernCheckbox id="eg-kv" checked={snapshot.pflichtKV} onChange={(v) => updateField('pflichtKV', v)} label={<span className="text-sm">{t('eg.health')}</span>} ariaLabel={t('eg.healthAria')} />
                <ModernCheckbox id="eg-rv" checked={snapshot.pflichtRV} onChange={(v) => updateField('pflichtRV', v)} label={<span className="text-sm">{t('eg.pension')}</span>} ariaLabel={t('eg.pensionAria')} />
                <ModernCheckbox id="eg-av" checked={snapshot.pflichtAV} onChange={(v) => updateField('pflichtAV', v)} label={<span className="text-sm">{t('eg.unemployment')}</span>} ariaLabel={t('eg.unemploymentAria')} />
                <ModernCheckbox id="eg-childless" checked={snapshot.childless} onChange={(v) => updateField('childless', v)} label={<span className="text-sm">{t('eg.childless')}</span>} ariaLabel={t('eg.childlessAria')} />
              </div>
            </fieldset>
            <div className="grid grid-cols-2 gap-3">
              <Field id="eg-basis-months" label={t('eg.basisMonths')} hint={t('eg.months')}>
                <NumberInput id="eg-basis-months" value={snapshot.basisMonths} onChange={(v) => updateField('basisMonths', v)} step={1} min={0} unit="mo" placeholder={EXAMPLE.basisMonths} />
              </Field>
              <Field id="eg-plus-months" label={t('eg.plusMonths')} hint={t('eg.months')}>
                <NumberInput id="eg-plus-months" value={snapshot.plusMonths} onChange={(v) => updateField('plusMonths', v)} step={1} min={0} unit="mo" placeholder={EXAMPLE.plusMonths} />
              </Field>
            </div>
            <div className="grid grid-cols-2 gap-3">
              <Field id="eg-during" label={t('eg.duringLeave')} hint={t('eg.perMonth')}>
                <NumberInput id="eg-during" value={snapshot.duringLeave} onChange={(v) => updateField('duringLeave', v)} step={50} min={0} unit="€" placeholder={EXAMPLE.duringLeave} />
              </Field>
              <Field id="eg-multiples" label={t('eg.multiples')} hint={t('eg.multiplesHint')}>
                <NumberInput id="eg-multiples" value={snapshot.multiples} onChange={(v) => updateField('multiples', v)} step={1} min={0} placeholder={EXAMPLE.multiples} />
              </Field>
            </div>
            <ModernCheckbox
              id="eg-sibling"
