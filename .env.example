# Copy to .env before `docker compose up`:
#
#   cp .env.example .env
#
# docker-compose.yml refuses to start without POSTGRES_PASSWORD and DATABASE_URL rather
# than falling back to a placeholder password, so this file is not optional. Change the
# password below before running anything you would mind other people reaching.

# ─── Database ────────────────────────────────────────────────────────────────
# Must match DATABASE_URL below.
POSTGRES_USER=tools
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=tools
POSTGRES_PORT=5432

# The backend reaches Postgres over the compose network, so the host is the service
# name `postgres`, not localhost.
DATABASE_URL=postgres://tools:change-me-before-first-run@postgres:5432/tools

# ─── Cache / sessions ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated. The session cookie is marked Secure unless *every* origin here is
# local, so leaving a production origin in this list while testing over plain HTTP will
# stop the cookie being set.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Baked in at build time. It also decides the CSP `connect-src`, so it must be set
# before `next build`, not after. Use https in production — the generated policy drops
# `upgrade-insecure-requests` when this is plain http, and warns when it does.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── OIDC (optional) ─────────────────────────────────────────────────────────
# Leave unset to use email/password only.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback
